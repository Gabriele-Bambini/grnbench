{
  "name": "my-docker-model",
  "description": "Template: any container that reads expr.parquet and writes edges.parquet",
  "format": "parquet",
  "timeout_s": 7200,
  "env": {"OMP_NUM_THREADS": "4"},
  "command": [
    "docker", "run", "--rm",
    "-v", "{workdir}:/data",
    "my-registry/my-grn-model:1.0",
    "--expr", "/data/{expr_name}",
    "--tfs", "/data/{tfs_name}",
    "--params", "/data/{params_name}",
    "--out", "/data/{out_name}",
    "--threads", "{threads}",
    "--seed", "{seed}"
  ]
}
