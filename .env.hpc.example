# Copy to .env.hpc (untracked) and fill in YOUR values. Never commit .env.hpc.
# The SSH alias is defined in your own ~/.ssh/config (see docs/HPC.md, step 1).
GRNBENCH_HPC_HOST=bocconi-hpc
# Only needed if you do not use an ssh alias that already sets User:
GRNBENCH_HPC_USER=
# Repo directory on the cluster, relative to your $HOME:
GRNBENCH_HPC_DIR=grnbench
# Data root on the cluster (fetch_engine_datasets.sh target):
GRNBENCH_HPC_DATA=grnbench_data
